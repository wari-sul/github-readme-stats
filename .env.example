# Example environment file for GitHub Readme Stats
# Copy this file to .env and fill in your values

# REQUIRED: GitHub Personal Access Token
# Create a token at: https://github.com/settings/tokens
# Required scopes: repo, read:user
PAT_1=your_github_personal_access_token_here

# OPTIONAL: Port for the server (default: 9000)
PORT=9000

# OPTIONAL: Cache duration in seconds (default: 86400 = 24 hours)
# Set to 0 to disable caching
CACHE_SECONDS=86400

# OPTIONAL: Comma-separated list of allowed GitHub usernames
# Leave empty to allow all usernames
WHITELIST=

# OPTIONAL: Comma-separated list of allowed Gist IDs
# Leave empty to allow all Gist IDs
GIST_WHITELIST=

# OPTIONAL: Comma-separated list of repositories to exclude from stats
# Useful for excluding private repositories from stats
EXCLUDE_REPO=

# OPTIONAL: Enable fetching all starred repositories for accurate star counts
# This may increase response times and API usage (default: false)
FETCH_MULTI_PAGE_STARS=false
